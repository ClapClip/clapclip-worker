# Standalone workbench only. No backend URL, Cognito account or node token.
# Copy to .env.local and pass --env-file .env.local explicitly.
MODELS_DIR=~/.mediaworker/models
FACESWAP_MODELS_DIR=~/.mediaworker/models
CUTOUT_MODELS_DIR=~/.mediaworker/models/cutout
ENHANCE_MODELS_DIR=~/.mediaworker/models/enhance
AUTO_UPDATE=false
# Optional provider order: Windows DirectML; Linux CUDA; macOS CoreML.
# ONNX_PROVIDERS=DmlExecutionProvider,CPUExecutionProvider
# DOWNLOAD_PUBLIC_DNS=true
