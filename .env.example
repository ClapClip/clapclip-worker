# --- Connection to your compatible Worker API ---
# Base URL of the Next.js app that exposes /api/worker/*. Outbound HTTPS only.
API_BASE_URL=https://worker.example.com
# Stable identity for this machine. Defaults to the hostname when empty.
NODE_ID=

# Preferred: sign in with a Cognito account in the `worker` group. The node
# exchanges the verified Cognito ID token for a per-process node token.
WORKER_COGNITO_USERNAME=
WORKER_COGNITO_PASSWORD=
WORKER_COGNITO_USER_POOL_ID=
WORKER_COGNITO_CLIENT_ID=
WORKER_COGNITO_REGION=ap-northeast-1

# Legacy/headless option: a pre-issued per-node token. When set, Cognito login
# is skipped.
NODE_TOKEN=

# --- What the shared node is authorized to do ---
# One unified process advertises and processes these capabilities.
CAPABILITIES=faceswap,cutout,enhance,download
# Optional filter for which authorized capabilities this node claims.
# WORKER_CLAIM_CAPABILITIES=download
# Download task endpoint namespace; AI tasks keep using /api/worker/*.
WORKER_DOWNLOAD_API_PREFIX=/api/worker/download
# Both modes default to the same per-user token cache and shared 3-slot pool.
# NODE_TOKEN_FILE=~/.mediaworker/node-token.json
# NODE_RUNTIME_DIR=~/.mediaworker
# Image enhancement requires the local ONNX models configured below and the
# enhance capability authorized on the API/account.
# trusted | untrusted. Your own machines are `trusted` (may run sensitive jobs
# like real user face swaps). Public/volunteer nodes are `untrusted`.
TRUST_TIER=trusted

# --- Runtime ---
# Concurrent jobs this node processes. Values above 3 are capped at 3.
CONCURRENCY=1
# How often to poll for work when idle (ms).
POLL_INTERVAL_MS=2000
# HTTP timeout for a claim/complete/fail call (s).
CLAIM_TIMEOUT_S=30
# Check the configured Git remote for fast-forward updates. After updating, the
# node finishes in-flight jobs and exits so the Windows task can restart it.
WORKER_AUTO_UPDATE=false
WORKER_AUTO_UPDATE_INTERVAL_S=300
WORKER_AUTO_UPDATE_REMOTE=origin
WORKER_AUTO_UPDATE_BRANCH=main
# Independent worker-side input and output limits; keep inputs aligned with API.
MAX_IMAGE_BYTES=6291456
MAX_IMAGE_PIXELS=16000000
MAX_IMAGE_DIMENSION=8192
MAX_OUTPUT_PIXELS=32000000
MAX_RESULT_BYTES=33554432
# Rotating logs work with pythonw/background startup too.
# LOG_FILE=~/.mediaworker/logs/worker.log

# --- ONNX Runtime execution providers ---
# Leave unset to auto-pick by OS (macOS=CoreML, Windows=DirectML, Linux=CUDA),
# filtered to what's actually installed. Legacy engines may fall back to CPU;
# enhance requires DirectML or CUDA and never falls back to CPU inference.
# ONNX_PROVIDERS=CoreMLExecutionProvider,CPUExecutionProvider

# Face-swap model file. Defaults to inswapper_128.onnx inside MODELS_DIR; set
# this to another filename (resolved in MODELS_DIR) or an absolute path to use a
# variant, e.g. the half-precision inswapper_128_fp16.onnx.
# FACESWAP_SWAP_MODEL=inswapper_128_fp16.onnx
# Optional directory containing inswapper_128.onnx and hyperswap_1a/b/c_256.onnx.
# Defaults to MODELS_DIR.
# FACESWAP_MODELS_DIR=

# Background-removal engine. The verified model is downloaded on the first
# startup and cached below CUTOUT_MODELS_DIR. isnet-general-use is a
# general-purpose local ONNX model and does not send images to another service.
CUTOUT_MODEL=isnet-general-use
# CUTOUT_MODELS_DIR=~/.mediaworker/models/cutout
CUTOUT_MODEL_AUTO_DOWNLOAD=true


# Optional image enhancement: provision ONNX files locally; no automatic download.
# See docs/distributed-mode.md for model files and supported scales.
# ENHANCE_MODELS_DIR=~/.mediaworker/models/enhance
ENHANCE_MODELS=standard,fast,deblur,animation
# Empty disables portrait model loading; available models also need yoloface_8n.onnx.
ENHANCE_FACE_MODELS=gfpgan,gpen

# Missing or invalid FaceSwap model files are pulled from this pinned private
# GitHub Release at startup. Use a fine-grained token with read-only Contents
# access to this repository. Existing files with matching SHA-256 are reused.
FACESWAP_MODEL_AUTO_DOWNLOAD=true
FACESWAP_MODEL_REPOSITORY=
FACESWAP_MODEL_RELEASE=faceswap-models-v1.0.0
GITHUB_TOKEN=

# --- Local paths (models cache + scratch workdir) ---
# MODELS_DIR=~/.mediaworker/models
# WORK_DIR=~/.mediaworker/work
